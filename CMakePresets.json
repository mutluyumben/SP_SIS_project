{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-mingw",
            "displayName": "Windows MinGW (MSYS2)",
            "description": "Windows build with vcpkg and MinGW",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/mingw32-make.exe"
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "description": "Windows build with Visual Studio Build Tools",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build-msvc",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "docker",
            "displayName": "Docker Build",
            "description": "Build for Docker (no vcpkg needed)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build"
        }
    ],
    "buildPresets": [
        {
            "name": "windows-mingw-build",
            "configurePreset": "windows-mingw"
        },
        {
            "name": "windows-msvc-build",
            "configurePreset": "windows-msvc"
        }
    ]
}